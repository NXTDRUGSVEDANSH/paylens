# OpenRouter key — single key for both models (same as Fractal AI's LLM_API_KEY)
LLM_API_KEY=sk-or-v1-your-key-here

# Models (OpenRouter ids)
PLANNER_MODEL=qwen/qwen3-coder-next
NARRATOR_MODEL=google/gemini-3-flash-preview

# Storage. CHROMA_PATH must be ABSOLUTE — Fractal AI's CWD-relative "./chroma_db"
# puts the KB wherever uvicorn was launched from.
DUCKDB_PATH=./data/paylens.duckdb
CHROMA_PATH=./data/chroma_db

# Safety / cost controls
MAX_SQL_RETRIES=2
MAX_SQL_ROWS=5000
EXPLAIN_SCAN_LIMIT=50000000
SQL_TIMEOUT_S=10

# Caching
ANSWER_CACHE_TTL=600
ANSWER_CACHE_SIZE=256
CACHE_T1=0.95
CACHE_T2=0.75
